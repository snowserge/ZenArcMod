[
  {
    "type": "separator",
    "label": "General"
  },
  {
    "property": "zen-safe-close.enabled",
    "type": "checkbox",
    "label": "Enable ZenArcMod",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.protectPinned",
    "type": "checkbox",
    "label": "Unload pinned tabs instead of closing them",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.emptyScreen",
    "type": "checkbox",
    "label": "Show Zen's empty screen after closing a pinned tab",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.neutralFocus",
    "type": "checkbox",
    "label": "Remove address bar focus on the empty screen",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.preserveScroll",
    "type": "checkbox",
    "label": "Preserve tab list scroll position when showing the empty screen",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Pinned tab buttons"
  },
  {
    "property": "zen-safe-close.hideClose",
    "type": "checkbox",
    "label": "Hide the close button on pinned tabs",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.hideUnload",
    "type": "checkbox",
    "label": "Hide the minus (unload) button on pinned tabs",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Tab appearance"
  },
  {
    "property": "zen-safe-close.density",
    "type": "dropdown",
    "label": "Tab list density",
    "defaultValue": "roomy",
    "options": [
      {
        "label": "Roomy — native Zen spacing",
        "value": "roomy"
      },
      {
        "label": "Cosy",
        "value": "cosy"
      },
      {
        "label": "Compact",
        "value": "compact"
      }
    ]
  },
  {
    "property": "zen-safe-close.visuals",
    "type": "checkbox",
    "label": "Apply appearance effects to inactive tabs",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.visualScope",
    "type": "dropdown",
    "label": "Appearance effect scope",
    "defaultValue": "pinned",
    "options": [
      {
        "label": "Pinned tabs only",
        "value": "pinned"
      },
      {
        "label": "All tabs",
        "value": "all"
      }
    ]
  },
  {
    "property": "zen-safe-close.includeFolders",
    "type": "checkbox",
    "label": "Include tabs inside folders",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.inactive",
    "type": "dropdown",
    "label": "Treat these tabs as inactive",
    "defaultValue": "unloaded",
    "options": [
      {
        "label": "Unloaded tabs",
        "value": "unloaded"
      },
      {
        "label": "All unselected tabs",
        "value": "unselected"
      }
    ]
  },
  {
    "property": "zen-safe-close.effect",
    "type": "dropdown",
    "label": "Color effect",
    "defaultValue": "sepia",
    "options": [
      {
        "label": "Sepia",
        "value": "sepia"
      },
      {
        "label": "Grayscale",
        "value": "grayscale"
      },
      {
        "label": "Original colors",
        "value": "none"
      }
    ]
  },
  {
    "property": "zen-safe-close.opacity",
    "type": "string",
    "label": "Opacity: 0.1–1 (1 = fully opaque)",
    "defaultValue": "1"
  },
  {
    "property": "zen-safe-close.strength",
    "type": "string",
    "label": "Sepia / grayscale strength: 0–1",
    "defaultValue": "1"
  },
  {
    "property": "zen-safe-close.saturation",
    "type": "string",
    "label": "Sepia saturation: 0–2",
    "defaultValue": "0.6"
  },
  {
    "type": "separator",
    "label": "System page gestures"
  },
  {
    "property": "zen-safe-close.gestures",
    "type": "checkbox",
    "label": "Enable right mouse button gestures where Gesturefy is unavailable",
    "defaultValue": true
  },
  {
    "property": "zen-safe-close.newGesture",
    "type": "string",
    "label": "New tab gesture: U/D/L/R or arrows; leave empty to disable",
    "defaultValue": "D"
  },
  {
    "property": "zen-safe-close.closeGesture",
    "type": "string",
    "label": "Close tab gesture: U/D/L/R or arrows; leave empty to disable",
    "defaultValue": "DR"
  },
  {
    "property": "zen-safe-close.gestureDistance",
    "type": "string",
    "label": "Minimum movement distance in pixels: 8–200",
    "defaultValue": "24"
  },
  {
    "type": "separator",
    "label": "Advanced"
  },
  {
    "property": "zen-safe-close.settleTime",
    "type": "string",
    "label": "Focus and scroll correction time in milliseconds: 0–1000",
    "defaultValue": "200"
  },
  {
    "property": "zen-safe-close.menuDelay",
    "type": "string",
    "label": "Suppress context menu after a gesture in milliseconds: 0–1500",
    "defaultValue": "500"
  },
  {
    "type": "separator",
    "label": "Gestures must be different. Invalid settings disable the system page gesture handler."
  }
]
